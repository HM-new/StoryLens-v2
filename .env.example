GEMINI_API_KEY=
# Optional Gemini tuning
GEMINI_MODEL=
GEMINI_BACKUP_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_RETRIES_PER_MODEL=3
GEMINI_TIMEOUT_MS=120000
GEMINI_PHASE1_MAX_ATTEMPTS=3
GEMINI_PHASE1_RETRY_DELAY_MS=15000

# Optional fallbacks for other phases/tools, not used by default
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Image generation provider: gemini, openai, or chatgpt
IMAGE_PROVIDER=gemini
OPENAI_IMAGE_RESPONSES_MODEL=gpt-5.5
OPENAI_IMAGE_TIMEOUT_MS=180000
PORT=3002
